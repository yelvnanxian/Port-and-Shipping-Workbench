{
  "name": "port-ops-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run preflight && concurrently -n web,api -c cyan,green \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "npm run preflight && tsx watch server/index.ts",
    "setup": "node scripts/setup.mjs",
    "preflight": "node scripts/preflight.mjs",
    "build": "tsc -b && vite build",
    "test": "tsx --test server/**/*.test.ts",
    "start": "npm run preflight && tsx server/index.ts",
    "cleanup:evidence": "tsx scripts/cleanup-evidence.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "patchright": "1.62.1",
    "pg": "^8.23.0",
    "playwright-core": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
